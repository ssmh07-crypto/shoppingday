[Unit]
Description=Shoppingday Naver Commerce API relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shoppingday
Group=shoppingday
WorkingDirectory=/opt/shoppingday
EnvironmentFile=/etc/shoppingday/naver-relay.env
ExecStart=/usr/bin/npm run naver:relay
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/shoppingday

[Install]
WantedBy=multi-user.target
